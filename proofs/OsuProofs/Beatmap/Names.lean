/-
`beatmap::names`: setting-key and enum-member name tables. The Rust side works with integer ids
(`K_*`, `T_*`); the spec with strings. `keyNames` / `enumTable` give the meaning of the ids (the same
definitions as the `AbsTo U32 String` / `AbsTo U32 (List (String × Int32))` maps that
`scripts/gen_abs.py` generates from the Rust literals; the key list below is its output).
-/
import OsuProofs.Beatmap.DotNetStr
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
open Aeneas Aeneas.Std Result
open OsuModel.Net OsuModel.Beatmap

namespace OsuProofs
open OsuImpl

/-- `beatmap::names` setting keys (index = Rust key id; generated by gen_abs.py). -/
def keyNames : List String := ["retries", "speed_change", "adjust_pitch", "fail_on_slider_tail", "restart", "only_fade_approach_circles", "follow_delay", "size_multiplier", "combo_based_size", "minimum_accuracy", "accuracy_judge_mode", "seed", "metronome", "circle_size", "approach_rate", "drain_rate", "overall_difficulty", "extended_limits", "no_slider_head_accuracy", "classic_note_lock", "always_play_tail_sample", "fade_hit_circle_early", "classic_health", "angle_sharpness", "reflection", "strength", "start_scale", "initial_rate", "final_rate", "spin_speed", "direction", "scale", "style", "inverse_muting", "enable_metronome", "mute_combo_count", "affects_hit_sounds", "hidden_combo_count", "attraction_strength", "repulsion_strength", "max_depth", "show_approach_circles", "max_size_combo_count", "max_cursor_size"]

/-- the setting key of id \`k\` (\`""\` for an unknown id) -/
def keyName (k : Nat) : String := keyNames.getD k ""

/-- \`beatmap::names\` enum member tables (member \`i\` has value \`i\`): \`T_SECTION\` = \`sectionNames\`,
\`T_EVENT_TYPE\` = \`eventTypeNames\`, then the \`sEnum\` lists of \`Settings.table\` (AC, MR, BR, AD). -/
def enumTable : Nat → List (String × Int32)
  | 0 => sectionNames
  | 1 => eventTypeNames
  | 2 => [("MaximumAchievable", 0), ("Standard", 1)]
  | 3 => [("Horizontal", 0), ("Vertical", 1), ("Both", 2)]
  | 4 => [("Clockwise", 0), ("Counterclockwise", 1)]
  | 5 => [("Linear", 0), ("Gravity", 1), ("InOut1", 2), ("InOut2", 3), ("Accelerate1", 4),
          ("Accelerate2", 5), ("Accelerate3", 6), ("Decelerate1", 7), ("Decelerate2", 8), ("Decelerate3", 9)]
  | _ => []

theorem names_u32_mk_val (b : BitVec 32) : (UScalar.mk (ty := .U32) b).val = b.toNat := rfl

theorem names_u32_eq_iff (a b : U32) : a = b ↔ a.val = b.val :=
  ⟨fun h => h ▸ rfl, fun h => UScalar.eq_of_val_eq h⟩

theorem keyNames_length : keyNames.length = 44 := rfl

theorem keyName_ne_empty (k : Nat) : keyName k ≠ "" ↔ k < 44 := by
  constructor
  · intro h; by_contra hk; apply h; simp only [keyName, List.getD_eq_getElem?_getD]
    rw [List.getElem?_eq_none (by rw [keyNames_length]; omega)]; rfl
  · intro h; revert k; decide

theorem keyName_inj (a b : Nat) (ha : a < 44) (hb : b < 44) : keyName a = keyName b ↔ a = b := by
  have hnd : keyNames.Nodup := by decide
  simp only [keyName, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (show a < keyNames.length from ha),
    List.getElem?_eq_getElem (show b < keyNames.length from hb), Option.getD_some]
  exact hnd.getElem_inj_iff

/-- \`key_is k s\`: \`s\` is the JSON name of setting \`k\`. -/
theorem beatmap.names.key_is_refines (k : U32) (s : Slice U32) (hs : ValidStr s) :
    beatmap.names.key_is k s = ok (decide (k.val < 44 ∧ strS s = (keyName k.val).toList)) := by
  unfold beatmap.names.key_is
  split
  all_goals simp [lift, Array.to_slice, Array.make, beatmap.dotnet.str_eq_refines s hs, litS, keyName, keyNames,
    names_u32_mk_val]
  intro h; exfalso
  simp only [names_u32_eq_iff, names_u32_mk_val, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod, imp_false] at *
  omega

theorem enumTable_ge (n : Nat) (h : 6 ≤ n) : enumTable n = [] := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 6 := ⟨n - 6, by omega⟩
  rfl

/-- \`table_len t\` = the number of members of enum table \`t\`. -/
theorem beatmap.names.table_len_refines (t : U32) :
    ∃ r, beatmap.names.table_len t = ok r ∧ r.val = (enumTable t.val).length := by
  unfold beatmap.names.table_len
  split
  all_goals refine ⟨_, rfl, ?_⟩
  all_goals try (simp [enumTable, sectionNames, eventTypeNames, names_u32_mk_val]; done)
  simp only [names_u32_eq_iff, names_u32_mk_val, BitVec.toNat_ofNat, Nat.reducePow, Nat.reduceMod, imp_false] at *
  rw [enumTable_ge _ (by omega)]; rfl

/-- \`table_name_is t k s\`: member \`k\` of enum table \`t\` is named \`s\`. -/
theorem beatmap.names.table_name_is_refines (t : U32) (k : Usize) (s : Slice U32) (hs : ValidStr s) :
    beatmap.names.table_name_is t k s =
      ok (decide (k.val < (enumTable t.val).length ∧ strS s = ((enumTable t.val).getD k.val ("", 0)).1.toList)) := by
  unfold beatmap.names.table_name_is
  split
  all_goals try split
  all_goals try simp only [lift, Array.to_slice, Array.make, beatmap.dotnet.str_eq_refines s hs, bind_ok]
  all_goals try (congr 1; symm; rw [decide_eq_false_iff_not]; rintro ⟨h1, -⟩; simp only [imp_false] at *; simp [enumTable, sectionNames, eventTypeNames, names_u32_mk_val] at h1; omega)
  all_goals simp_all [litS, enumTable, sectionNames, eventTypeNames, names_u32_mk_val]

end OsuProofs
