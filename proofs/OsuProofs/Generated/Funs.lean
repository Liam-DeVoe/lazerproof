def net.libm.f64_log_base
  (a : float.F64) (new_base : float.F64) : Result float.F64 := do
  let b ← float.F64.is_nan a
  if b
  then ok a
  else
    let b1 ← float.F64.is_nan new_base
    if b1
    then ok new_base
    else
      let f ← net.libm.ONE
      let b2 ← float.F64.eq new_base f
      if b2
      then net.basic.F64_NAN
      else
        let b3 ← float.F64.eq a f
        if b3
        then
          let f1 ← float.F64.log a
          let f2 ← float.F64.log new_base
          float.F64.div f1 f2
        else
          let f1 ← net.libm.ZERO
          let b4 ← float.F64.eq new_base f1
          if b4
          then net.basic.F64_NAN
          else
            let f2 ← net.basic.F64_POS_INF
            let b5 ← float.F64.eq new_base f2
            if b5
            then net.basic.F64_NAN
            else
              let f3 ← float.F64.log a
              let f4 ← float.F64.log new_base
              float.F64.div f3 f4

