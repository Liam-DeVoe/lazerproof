/-- [osu_eval_core::beatmap::mod_settings::set_difficulty]:
    Source: 'src/beatmap/mod_settings.rs', lines 376:0-394:1
    Visibility: public -/
def beatmap.mod_settings.set_difficulty
  (min : float.F32) (max : float.F32) (ext_min : Option float.F32)
  (ext_max : Option float.F32) (v : float.F32) :
  Result float.F32
  := do
  let lo ← match ext_min with
             | none => ok min
             | some x => ok x
  let hi ← match ext_max with
             | none => ok max
             | some x => ok x
  let f ← net.mathops.f32_min min v
  let cn_min ← net.mathops.f32_clamp f lo min
  let f1 ← net.mathops.f32_max max v
  let cn_max ← net.mathops.f32_clamp f1 max hi
  match cn_min with
  | core.result.Result.Ok a =>
    match cn_max with
    | core.result.Result.Ok b =>
      let r ← net.mathops.f32_clamp v a b
      match r with
      | core.result.Result.Ok r1 => ok r1
      | core.result.Result.Err _ => ok v
    | core.result.Result.Err _ => ok v
  | core.result.Result.Err _ => ok v

