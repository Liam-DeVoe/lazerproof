def beatmap.objects.duration
  (h : beatmap.objects.OsuHitObject) : Result float.F64 := do
  match h.kind with
  | beatmap.objects.ObjectKind.Circle =>
    let f ← beatmap.objects.end_time h
    float.F64.sub f h.start_time
  | beatmap.objects.ObjectKind.Slider _ =>
    let f ← beatmap.objects.end_time h
    float.F64.sub f h.start_time
  | beatmap.objects.ObjectKind.Spinner s => ok s.duration

/-- [osu_eval_core::beatmap::mod_target_practice::node_index_from_time]:
    Source: 'src/beatmap/mod_target_practice.rs', lines 234:0-242:1
    Visibility: public -/
def beatmap.mod_target_practice.node_index_from_time
  (h : beatmap.objects.OsuHitObject) (time_since_start : float.F64) :
  Result Std.I32
  := do
  let sc ←
    match h.kind with
    | beatmap.objects.ObjectKind.Circle => ok 1#i32
    | beatmap.objects.ObjectKind.Slider s => beatmap.objects.span_count s
    | beatmap.objects.ObjectKind.Spinner _ => ok 1#i32
  let f ← beatmap.objects.duration h
  let i ← lift (IScalar.cast .I64 sc)
  let f1 ← float.F64.from_i64 i
  let span_duration ← float.F64.div f f1
  let node_index ← float.F64.div time_since_start span_duration
  let f2 ← net.mathops.f64_round node_index
  let f3 ← float.F64.sub node_index f2
  let f4 ← float.F64.abs f3
  let f5 ← beatmap.mod_target_practice.D1
  let b ← float.F64.le f4 f5
  if b
  then float.F64.to_i32_sat f2
  else ok (-1)#i32

/-- [osu_eval_core::beatmap::mod_target_practice::sample_pred]:
    Source: 'src/beatmap/mod_target_practice.rs', lines 244:0-254:1 -/
def beatmap.mod_target_practice.sample_pred
  (o : beatmap.objects.OsuHitObject) (t : float.F64) : Result Bool := do
  let f ← float.F64.sub t o.start_time
  let f1 ← float.F64.abs f
  let f2 ← beatmap.mod_target_practice.TIMING_PRECISION
  let b ← float.F64.le f1 f2
  if b
  then ok true
  else
    let b1 ← beatmap.objects.is_slider o
    if b1
    then
      let b2 ← beatmap.mod_target_practice.almost_bigger t o.start_time
      if b2
      then
        let f3 ← beatmap.objects.end_time o
        let b3 ← beatmap.mod_target_practice.almost_bigger f3 t
        if b3
        then
          let i ← beatmap.mod_target_practice.node_index_from_time o f
          ok (i != (-1)#i32)
        else ok false
      else ok false
    else ok false

