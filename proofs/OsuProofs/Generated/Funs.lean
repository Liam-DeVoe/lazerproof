def beatmap.playable.get_playable_beatmap
  (d : beatmap.types.DecodedBeatmap)
  (mods_list : Slice beatmap.mod_settings.ModConfig) :
  Result (core.result.Result beatmap.playable.PlayableBeatmap
    beatmap.hit_object_parser.DecodeError)
  := do
  let bm ← beatmap.playable.convert_beatmap d
  let bm1 ← beatmap.playable.get_playable_beatmap_loop0 mods_list bm 0#usize
  let bm2 ← beatmap.playable.get_playable_beatmap_loop1 mods_list bm1 0#usize
  let v ← beatmap.processor.pre_process bm2.hit_objects
  let (v1, err) ←
    beatmap.playable.get_playable_beatmap_loop2 bm2.difficulty
      bm2.control_points v none 0#usize
  match err with
  | none =>
    let v2 ← beatmap.playable.get_playable_beatmap_loop3 mods_list v1 0#usize
    let v3 ←
      beatmap.processor.apply_stacking_all bm2.format_version
        bm2.stack_leniency v2
    let (bm3, err1) ←
      beatmap.playable.get_playable_beatmap_loop4 mods_list
        { bm2 with hit_objects := v3 } 0#usize none
    match err1 with
    | none =>
      let s := alloc.vec.Vec.deref bm3.hit_objects
      let b ← beatmap.playable.any_path_fuel_out s
      if b
      then
        ok (core.result.Result.Err (beatmap.hit_object_parser.DecodeError.Msg
          beatmap.errors.M_SLIDER_PATH_FUEL_EXHAUSTED))
      else ok (core.result.Result.Ok bm3)
    | some e => ok (core.result.Result.Err e)
  | some e => ok (core.result.Result.Err e)

