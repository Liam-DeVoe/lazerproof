def net.decimal.of_f32
  (input : float.F32) :
  Result (core.result.Result net.decimal.NetDecimal net.basic.NetExn)
  := do
  let b ← float.F32.is_nan input
  if b
  then ok (core.result.Result.Err net.basic.NetExn.Overflow)
  else
    let i ← float.F32.to_bits input
    let i1 ← i >>> 23#i32
    let i2 ← lift (i1 &&& 255#u32)
    let e ← lift (UScalar.hcast .I64 i2)
    let num ← e - 126#i64
    if num < (-94)#i64
    then ok (core.result.Result.Ok net.decimal.ZERO)
    else
      if num > 96#i64
      then ok (core.result.Result.Err net.basic.NetExn.Overflow)
      else
        let f ← net.decimal.F32_ZERO
        let neg ← float.F32.lt input f
        let input1 ← if neg
                       then float.F32.neg input
                       else ok input
        let dbl0 ← float.F32.to_f64 input1
        let i3 ← num * 19728#i64
        let i4 ← net.decimal.sar i3 16#u32
        let power0 ← 6#i64 - i4
        let (dbl, power) ←
          if power0 >= 0#i64
          then
            do
            let power1 ← if power0 > 28#i64
                           then ok 28#i64
                           else ok power0
            let i5 ← lift (IScalar.hcast .U32 power1)
            let f1 ← net.decimal.double_powers10 i5
            let dbl1 ← float.F64.mul dbl0 f1
            ok (dbl1, power1)
          else
            if power0 != (-1)#i64
            then
              do
              let i5 ← -. power0
              let i6 ← lift (IScalar.hcast .U32 i5)
              let f1 ← net.decimal.double_powers10 i6
              let dbl1 ← float.F64.div dbl0 f1
              ok (dbl1, power0)
            else
              do
              let f1 ← net.decimal.P1E7
              let b1 ← float.F64.le f1 dbl0
              if b1
              then
                let i5 ← -. power0
                let i6 ← lift (IScalar.hcast .U32 i5)
                let f2 ← net.decimal.double_powers10 i6
                let dbl1 ← float.F64.div dbl0 f2
                ok (dbl1, power0)
              else ok (dbl0, 0#i64)
        let f1 ← net.decimal.P1E6
        let b1 ← float.F64.lt dbl f1
        let (dbl1, power1) ←
          if b1
          then
            if power < 28#i64
            then
              do
              let f2 ← net.decimal.F64TEN
              let dbl2 ← float.F64.mul dbl f2
              let power2 ← power + 1#i64
              ok (dbl2, power2)
            else ok (dbl, power)
          else ok (dbl, power)
        let f2 ← net.mathops.f64_round dbl1
        let r ← float.F64.to_i32_sat f2
        let mant ←
          if r < 0#i32
          then ok 0#u128
          else ok (IScalar.hcast .U128 r)
        if mant = 0#u128
        then ok (core.result.Result.Ok net.decimal.ZERO)
        else
          let s ← lift (Array.to_slice net.decimal.STEPS_R4)
          net.decimal.finish_from_r neg mant power1 6#u32 s

