def net.framework.clamp_scale_comp (s : float.F32) : Result float.F32 := do
  let f ← float.F32.abs s
  let f1 ← net.framework.FLOAT_EPSILON
  let b ← float.F32.lt f f1
  if b
  then
    let one ← float.F32.from_bits 1065353216#u32
    let f2 ← float.F32.from_bits 0#u32
    let b1 ← float.F32.eq s f2
    let sg ←
      if b1
      then ok one
      else
        do
        let b2 ← float.F32.lt s f2
        if b2
        then float.F32.neg one
        else ok one
    float.F32.mul sg f1
  else ok s

