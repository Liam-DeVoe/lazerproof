      let f ←
        if b
        then net.min gst r
        else
          do
          let f1 ← float.F64.sub st.manual r
          let f2 ← float.F64.abs f1
          let f3 ← schedule.CATCHUP_THRESHOLD
          let b1 ← float.F64.lt f3 f2
          if b1
          then
            let b2 ← float.F64.lt st.manual r
            if b2
            then
              let f4 ← schedule.SIXTY_FRAME_TIME
              let f5 ← float.F64.add st.manual f4
              net.min r f5
            else
              let f4 ← schedule.SIXTY_FRAME_TIME
              let f5 ← float.F64.sub st.manual f4
              net.max r f5
          else ok r
      ok (st.first, f)
  let i := Slice.len frames
  if i = 0#usize
  then ok { st with first, manual := proposed, handler_time := proposed }
  else
    let fs ← schedule.frame_time frames st.idx
    let i1 ← st.idx + 1#i64
    let fe ← schedule.frame_time frames i1
    let b ← float.F64.le fe proposed
    let (idx, proposed1) ←
      if b
      then ok (i1, fe)
      else
        do
        let b1 ← float.F64.lt proposed fs
        let i2 ←
          if b1
          then
            do
            let b2 ← float.F64.eq st.handler_time fs
            if b2
            then st.idx - 1#i64
            else ok st.idx
          else ok st.idx
        ok (i2, proposed)
    let fs1 ← schedule.frame_time frames idx
    let i2 ← idx + 1#i64
    let fe1 ← schedule.frame_time frames i2
    let o ← net.clamp proposed1 fs1 fe1
    match o with
    | none => ok { first, manual := proposed1, idx, handler_time := proposed1 }
    | some v => ok { first, manual := v, idx, handler_time := v }

