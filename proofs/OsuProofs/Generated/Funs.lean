def beatmap.playable.load
  (bytes : Slice Std.U8) (mods_list : Slice beatmap.mod_settings.ModConfig) :
  Result beatmap.playable.LoadResult
  := do
  let r ← beatmap.decoder.decode bytes
  match r with
  | core.result.Result.Ok d =>
    if d.ruleset_id != 0#i32
    then ok (beatmap.playable.LoadResult.OtherRuleset d.ruleset_id)
    else
      let r1 ← beatmap.playable.get_playable_beatmap d mods_list
      match r1 with
      | core.result.Result.Ok pb => ok (beatmap.playable.LoadResult.Ok pb)
      | core.result.Result.Err e =>
        ok (beatmap.playable.LoadResult.PlayableError e)
  | core.result.Result.Err e => ok (beatmap.playable.LoadResult.DecodeError e)

