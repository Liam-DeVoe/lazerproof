  if b1
  then ok { x := rad, y }
  else
    let v ← beatmap.mod_random.BASE_SIZE
    let f ← float.F32.sub v.x rad
    let b2 ← float.F32.lt f p.x
    if b2
    then let x ← float.F32.sub v.x rad
         ok { x, y }
    else ok { p with y }

