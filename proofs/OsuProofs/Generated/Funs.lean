  | beatmap.mod_settings.JsonVal.Big => ok false
  | beatmap.mod_settings.JsonVal.Double _ => ok false
  | beatmap.mod_settings.JsonVal.Bool _ => ok false
  | beatmap.mod_settings.JsonVal.Str s =>
    let i := alloc.vec.Vec.len s
    ok (i = 0#usize)
  | beatmap.mod_settings.JsonVal.Null => ok true

/-- [osu_eval_core::beatmap::mod_settings::parse]:
    Source: 'src/beatmap/mod_settings.rs', lines 406:0-470:1
    Visibility: public -/
def beatmap.mod_settings.parse
  (t : beatmap.mod_settings.SettingType)
  (old : beatmap.mod_settings.SettingValue) (j : beatmap.mod_settings.JsonVal)
  :
  Result (Option beatmap.mod_settings.SettingValue)
  := do
  match t with
  | beatmap.mod_settings.SettingType.Bool bb =>
    let r ← beatmap.mod_settings.to_bool bb j
    match r with
    | core.result.Result.Ok b =>
      ok (some (beatmap.mod_settings.SettingValue.Bool b))
    | core.result.Result.Err _ => ok none
  | beatmap.mod_settings.SettingType.Int mn mx =>
    let r ← beatmap.mod_settings.to_int32 j
    match r with
    | core.result.Result.Ok v =>
      let i ← beatmap.mod_settings.set_int mn mx v
      ok (some (beatmap.mod_settings.SettingValue.Int i))
    | core.result.Result.Err _ => ok none
  | beatmap.mod_settings.SettingType.Double mn mx p =>
    let o ←
      match old with
      | beatmap.mod_settings.SettingValue.Bool _ => beatmap.mod_settings.D0
      | beatmap.mod_settings.SettingValue.Int _ => beatmap.mod_settings.D0
      | beatmap.mod_settings.SettingValue.Double x => ok x
      | beatmap.mod_settings.SettingValue.Float _ => beatmap.mod_settings.D0
      | beatmap.mod_settings.SettingValue.Enum _ => beatmap.mod_settings.D0
      | beatmap.mod_settings.SettingValue.OptInt _ => beatmap.mod_settings.D0
      | beatmap.mod_settings.SettingValue.OptFloat _ => beatmap.mod_settings.D0
    let r ← beatmap.mod_settings.to_f64 j
    match r with
    | core.result.Result.Ok v =>
      let o1 ← beatmap.mod_settings.set_double mn mx p o v
      match o1 with
      | none => ok none
      | some x => ok (some (beatmap.mod_settings.SettingValue.Double x))
    | core.result.Result.Err _ => ok none
  | beatmap.mod_settings.SettingType.Float mn mx p =>
    let o ←
      match old with
      | beatmap.mod_settings.SettingValue.Bool _ => float.F32.from_bits 0#u32
      | beatmap.mod_settings.SettingValue.Int _ => float.F32.from_bits 0#u32
      | beatmap.mod_settings.SettingValue.Double _ => float.F32.from_bits 0#u32
      | beatmap.mod_settings.SettingValue.Float x => ok x
      | beatmap.mod_settings.SettingValue.Enum _ => float.F32.from_bits 0#u32
      | beatmap.mod_settings.SettingValue.OptInt _ => float.F32.from_bits 0#u32
      | beatmap.mod_settings.SettingValue.OptFloat _ =>
        float.F32.from_bits 0#u32
    let r ← beatmap.mod_settings.to_f32 j
    match r with
    | core.result.Result.Ok v =>
      let o1 ← beatmap.mod_settings.set_float mn mx p o v
      match o1 with
      | none => ok none
      | some x => ok (some (beatmap.mod_settings.SettingValue.Float x))
    | core.result.Result.Err _ => ok none
  | beatmap.mod_settings.SettingType.Enum names =>
    let o ← beatmap.mod_settings.enum_string j
    match o with
    | none => ok none
    | some s =>
      let s1 := alloc.vec.Vec.deref s
      let o1 ← beatmap.dotnet.enum_try_parse names s1
      match o1 with
      | none => ok none
      | some x => ok (some (beatmap.mod_settings.SettingValue.Enum x))
  | beatmap.mod_settings.SettingType.NullableInt =>
    let b ← beatmap.mod_settings.is_null_or_empty j
    if b
    then ok (some (beatmap.mod_settings.SettingValue.OptInt none))
    else
      let r ← beatmap.mod_settings.to_int32 j
      match r with
      | core.result.Result.Ok v =>
        ok (some (beatmap.mod_settings.SettingValue.OptInt (some v)))
      | core.result.Result.Err _ => ok none
  | beatmap.mod_settings.SettingType.Difficulty mn mx emn emx =>
    let b ← beatmap.mod_settings.is_null_or_empty j
    if b
    then ok (some (beatmap.mod_settings.SettingValue.OptFloat none))
    else
      let r ← beatmap.mod_settings.to_f32 j
      match r with
      | core.result.Result.Ok v =>
        let f ← beatmap.mod_settings.set_difficulty mn mx emn emx v
        ok (some (beatmap.mod_settings.SettingValue.OptFloat (some f)))
      | core.result.Result.Err _ => ok none

