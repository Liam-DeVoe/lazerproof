def beatmap.chartable.char_is_letter (n : Std.U32) : Result Bool := do
  if n < 128#u32
  then
    if 97#u32 <= n
    then
      if n <= 122#u32
      then ok true
      else if 65#u32 <= n
           then ok (n <= 90#u32)
           else ok false
    else if 65#u32 <= n
         then ok (n <= 90#u32)
         else ok false
  else
    let s ← lift (Array.to_slice beatmap.chartable.LETTER_RANGES)
    let hi := Slice.len s
    beatmap.chartable.char_is_letter_loop n 0#usize hi false 0#i32

