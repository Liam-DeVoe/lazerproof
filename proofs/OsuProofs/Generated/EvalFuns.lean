def eval.gameplay_playable
  (d : beatmap.types.DecodedBeatmap)
  (mods : Slice beatmap.mod_settings.ModConfig) :
  Result (core.result.Result beatmap.playable.PlayableBeatmap eval.Rejection)
  := do
  let o ← eval.find_unseeded mods
  match o with
  | none =>
    let r ← eval.playable_of d mods
    match r with
    | core.result.Result.Ok pb => ok (core.result.Result.Ok pb)
    | core.result.Result.Err e =>
      let r1 ← eval.reject eval.Stage.Playable (eval.Reason.Decode e)
      ok (core.result.Result.Err r1)
  | some i =>
    let mc ← Slice.index_usize mods i
    let v ← alloc.vec.CloneVec.clone core.clone.CloneU32 mc.acronym
    let r ← eval.reject eval.Stage.Playable (eval.Reason.Unseeded v)
    ok (core.result.Result.Err r)

