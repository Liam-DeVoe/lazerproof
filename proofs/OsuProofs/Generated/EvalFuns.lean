def eval.decode_time_check
  (d : beatmap.types.DecodedBeatmap)
  (decode_time_mods : Slice beatmap.mod_settings.ModConfig)
  (mods : Slice beatmap.mod_settings.ModConfig) :
  Result (core.result.Result Unit eval.Rejection)
