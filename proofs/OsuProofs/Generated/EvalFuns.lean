/-- [osu_eval_core::eval::osr::decode]:
    Source: 'osu_eval_core/src/eval/osr.rs', lines 841:0-852:1
    Visibility: public -/
def eval.osr.decode
  (bytes : Slice Std.U8) :
  Result (core.result.Result eval.osr.DecodedScore eval.osr.OsrErr)
  := do
  let r ← eval.osr.parse_container bytes
  match r with
  | core.result.Result.Ok v =>
    let bitfield_mods ← eval.osr.convert_from_legacy_mods v.legacy_mods
    let bitfield_mods1 ←
      if v.version < eval.osr.FIRST_LAZER_VERSION
      then
        do
        let s ← lift (Array.to_slice (Array.make 2#usize [ 67#u8, 76#u8 ]))
        let v1 ← beatmap.dotnet.lit_str s
        let s1 := alloc.vec.Vec.deref v1
        let s2 :=
          alloc.vec.Vec.deref (alloc.vec.Vec.new ((alloc.vec.Vec Std.U32) ×
            beatmap.mod_settings.JsonVal))
        let mc ← beatmap.mod_settings.to_mod s1 s2
        alloc.vec.Vec.push bitfield_mods mc
      else ok bitfield_mods
    let r1 ← eval.osr.frame_text_of v
    match r1 with
    | core.result.Result.Ok v1 =>
      let s := alloc.vec.Vec.deref bitfield_mods1
      let r2 ← eval.osr.mods_of v s
      match r2 with
      | core.result.Result.Ok v2 =>
        ok (core.result.Result.Ok
          {
            container := v,
            is_legacy_score := (v.version < eval.osr.FIRST_LAZER_VERSION),
            bitfield_mods := bitfield_mods1,
            mods := v2,
            frame_text := v1
          })
      | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | core.result.Result.Err e => ok (core.result.Result.Err e)

