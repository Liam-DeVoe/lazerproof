def sim.step.processors_phase
  (c : sim.state.Ctx) (s : sim.state.St) :
  Result ((core.result.Result Unit sim.err.SimErr) × sim.state.St)
  := do
  let (c1, elapsed) ←
    if s.k = 0#usize
    then do
         let elapsed1 ← sim.step.F64_0
         ok (c, elapsed1)
    else
      do
      let i ← s.k - 1#usize
      let s1 ←
        alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
          schedule.Step) c.steps i
