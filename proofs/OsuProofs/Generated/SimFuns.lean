def sim.geometry.slider_geom_p
  (hoc : sim.basic.DrawInfo) (argon_path_radius : float.F32)
  (h : sim.playable.HObj) (pl : sim.geometry.Placement) (size : sim.basic.Vec2)
  (origin : sim.basic.Vec2) (rel_anchor : sim.basic.Vec2)
  (head_pl : sim.geometry.Placement) :
  Result sim.geometry.SliderGeom
  := do
  let v ← sim.basic.VEC2_ZERO
  let di ← sim.geometry.child_draw_info_r hoc pl.pos v pl.scale pl.rot origin
  let f ← sim.basic.F32_1
  let f1 ← float.F32.mul f size.x
  let f2 ← float.F32.mul f size.y
  let v1 ← sim.basic.Vec2.mul v size
  let v2 ← sim.basic.VEC2_ONE
  let hc ← sim.geometry.child_draw_info di v v1 v2 v
  let v3 ← sim.basic.Vec2.mul rel_anchor { x := f1, y := f2 }
  let head ← sim.geometry.receptor_from_placement hc head_pl v3 h.scale
  let f3 ← float.F32.mul argon_path_radius h.scale
  ok
    { path_radius := f3, size, origin, draw_info := di, head_receptor := head }

