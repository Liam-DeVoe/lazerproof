def sim.scoring.mk_health_cfg
  (pb : sim.playable.Playable) (legacy : Bool) :
  Result (core.result.Result sim.scoring.HealthCfg sim.err.SimErr)
  := do
  let hp ← float.F32.to_f64 pb.difficulty.hp
  let n := alloc.vec.Vec.len pb.objects
  let drain_start ←
    if n > 0#usize
    then
      do
      let «to» ←
        alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
          sim.playable.TopObj) pb.objects 0#usize
      ok «to».h.start
    else sim.scoring.F64_0
  let gameplay_end ←
    if n > 0#usize
    then
      do
      let i ← n - 1#usize
      let «to» ←
        alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
          sim.playable.TopObj) pb.objects i
      ok «to».h.end_time
    else sim.scoring.F64_0
  let periods ← sim.scoring.no_drain_periods pb
  if legacy
  then
    let r ← sim.scoring.compute_legacy_drain_rate pb hp drain_start
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      ok (core.result.Result.Ok
        {
          legacy,
          hp,
          drain_rate := val.test_drop,
          hp_multiplier_normal := val.mult,
          drain_start_time := drain_start,
          gameplay_end_time := gameplay_end,
          periods
        })
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        sim.scoring.HealthCfg (core.convert.FromSame sim.err.SimErr) residual
  else
    let f ← float.F64.from_bits 4607092346807469998#u64
    let f1 ← float.F64.from_bits 4606281698874543309#u64
    let f2 ← float.F64.from_bits 4600877379321698714#u64
    let target0 ← sim.scoring.difficulty_range hp f f1 f2
    let f3 ← sim.scoring.F64_1
    let f4 ← float.F64.sub f3 target0
    let f5 ← sim.scoring.F64_0
    let f6 ← float.F64.mul f5 f4
    let target1 ← float.F64.add target0 f6
    let target ← sim.netx.f64_clamp_or target1 f5 f3
    let js ← sim.scoring.simulated_judgements pb
    let h0 ← sim.scoring.health_st_init (alloc.vec.Vec.new Std.U64)
    let incs ←
      sim.scoring.mk_health_cfg_loop legacy hp f5 f3 drain_start gameplay_end
        periods js h0 (alloc.vec.Vec.new sim.scoring.Inc) 0#usize
    let s := alloc.vec.Vec.deref incs
    let s1 := alloc.vec.Vec.deref pb.breaks
    let r ← sim.scoring.compute_drain_rate s s1 drain_start target
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      ok (core.result.Result.Ok
        {
          legacy,
          hp,
          drain_rate := val,
          hp_multiplier_normal := f3,
          drain_start_time := drain_start,
          gameplay_end_time := gameplay_end,
          periods
        })
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        sim.scoring.HealthCfg (core.convert.FromSame sim.err.SimErr) residual

