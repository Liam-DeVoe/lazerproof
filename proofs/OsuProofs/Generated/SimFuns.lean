        alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
          sim.playable.TopObj) c.pb.objects i
      let i1 ←
        alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice Std.Usize)
          c.head_idx i
