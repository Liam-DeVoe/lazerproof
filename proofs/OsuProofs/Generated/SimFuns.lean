        replay.frames.Action.Left
    else ok replay.frames.ACTLIST_EMPTY
  let acts1 ←
    if right
    then replay.frames.act_push acts replay.frames.Action.Right
    else ok acts
  if smoke
  then
    let acts2 ← replay.frames.act_push acts1 replay.frames.Action.Smoke
    ok
      {
        time := f.time,
        pos := { x := f.mouse_x, y := f.mouse_y },
        actions := acts2
      }
  else
    ok
      {
        time := f.time,
        pos := { x := f.mouse_x, y := f.mouse_y },
        actions := acts1
      }

