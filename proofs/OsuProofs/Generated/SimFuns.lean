def sim.step.init_state
  (cfg : sim.mods.Config) (pb : sim.playable.Playable)
  (init_without_mods : Std.I64) :
  Result (core.result.Result sim.state.St sim.err.SimErr)
  := do
  let score ← sim.scoring.SCORE_ST_INIT
  let r ← sim.scoring.adjust_rank cfg.rank_adjust sim.scoring.Rank.X
  let v ← alloc.vec.CloneVec.clone core.clone.CloneU64 cfg.easy_retries
  let health ← sim.scoring.health_st_init v
  let objs ←
    sim.step.init_state_loop0 pb (alloc.vec.Vec.new sim.state.OState) 0#usize
  let r1 ← sim.step.as_init cfg
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r1
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let r2 ← sim.step.initial_speeds cfg
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r2
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue val1 =>
      let (as_recent, as_seen) ←
        sim.step.init_state_loop1 cfg.dyn_rates (alloc.vec.Vec.new
          (alloc.vec.Vec float.F64)) (alloc.vec.Vec.new (alloc.vec.Vec
          sim.step.Ref)) 0#usize
      let (block_last, block_idx) ←
        sim.step.init_state_loop2 cfg.input_blockers (alloc.vec.Vec.new (Option
          replay.frames.Action)) (alloc.vec.Vec.new Std.Usize) 0#usize
      let hs ← sim.scoring.HealthSt.Insts.CoreCloneClone.clone health
      let v1 ← sim.step.initial_pools
      let f ← sim.step.F64_0
      let v2 ← sim.basic.VEC2_ZERO
      let f1 ← sim.step.F64_1
      let f2 ← sim.basic.F32_0
      ok (core.result.Result.Ok
        {
          k := 0#usize,
          t := f,
          objs,
          first_lifetime_update := true,
          next_future := 0#usize,
          future_order := (alloc.vec.Vec.new Std.Usize),
          active := (alloc.vec.Vec.new Std.Usize),
          dict_slots := (alloc.vec.Vec.new (Option Std.Usize)),
          free_list := (alloc.vec.Vec.new Std.Usize),
          child_counter := 0#u64,
          mouse_valid := false,
          mouse := v2,
          last_replay := none,
          pressed := replay.frames.ACTLIST_EMPTY,
          score :=
            {
              score
                with
                total_score_without_mods := init_without_mods, rank := r
            },
          health := hs,
          score_rp :=
            {
              score
                with
                total_score_without_mods := init_without_mods, rank := r
            },
          health_rp := health,
          out := (alloc.vec.Vec.new sim.state.JRec),
          speed := val1,
          as_target := val,
          as_recent,
          as_seen,
          clock_rate := f1,
          relax_down := false,
          relax_was_left := false,
          relax_last := f,
          ap_frame := (-1)#i64,
          block_last,
          block_idx,
          insts := (alloc.vec.Vec.new sim.state.Inst),
          pools := v1,
          br_rot := f2,
          theta := f2,
          cursor_pos := v2
        })
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        sim.state.St (core.convert.FromSame sim.err.SimErr) residual
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
      sim.state.St (core.convert.FromSame sim.err.SimErr) residual

