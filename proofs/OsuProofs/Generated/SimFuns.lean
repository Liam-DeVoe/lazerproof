/-- [osu_eval_core::sim::geometry::receptor_contains]:
    Source: 'osu_eval_core/src/sim/geometry.rs', lines 206:0-225:1
    Visibility: public -/
def sim.geometry.receptor_contains
  (di : sim.basic.DrawInfo) (screen : sim.basic.Vec2) (corner_pow : float.F64)
  :
  Result Bool
  := do
  let corner_exponent ← sim.geometry.RECEPTOR_CORNER_EXPONENT
  let c_r ← sim.geometry.receptor_effective_corner_radius
  let f ← sim.basic.F32_0
  let b ← float.F32.eq c_r f
  if b
  then
    let l ← sim.basic.to_local di screen
    let b1 ← float.F32.le f l.x
    if b1
    then
      let f1 ← sim.geometry.F32_128
      let b2 ← float.F32.le l.x f1
      if b2
      then
        let b3 ← float.F32.le f l.y
        if b3
        then float.F32.le l.y f1
        else ok false
      else ok false
    else ok false
  else
    let l ← sim.basic.to_local di screen
    let f1 ← float.F32.neg c_r
    let rx ← float.F32.sub f f1
    let ry ← float.F32.sub f f1
    let f2 ← float.F32.add f1 f1
    let f3 ← sim.geometry.F32_128
    let rw ← float.F32.add f3 f2
    let f4 ← float.F32.add f1 f1
    let rh ← float.F32.add f3 f4
    let right ← float.F32.add rx rw
    let bottom ← float.F32.add ry rh
    let f5 ← float.F32.sub l.x right
    let f6 ← float.F32.sub rx l.x
    let f7 ← sim.netx.f32_max f5 f6
    let dist_x ← sim.netx.f32_max f f7
    let f8 ← float.F32.sub l.y bottom
    let f9 ← float.F32.sub ry l.y
    let f10 ← sim.netx.f32_max f8 f9
    let dist_y ← sim.netx.f32_max f f10
    let f11 ← float.F32.pow dist_x corner_exponent
    let f12 ← float.F32.pow dist_y corner_exponent
    let lhs ← float.F32.add f11 f12
    let f13 ← float.F32.to_f64 lhs
    float.F64.le f13 corner_pow

