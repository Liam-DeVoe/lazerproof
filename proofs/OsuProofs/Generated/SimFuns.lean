  Result (core.result.Result (sim.basic.Vec2 × sim.basic.Vec2) sim.err.SimErr)
  := do
  let s := alloc.vec.Vec.deref sd.path
  let b ← sim.geometry.path_bounds s r
  let n := alloc.vec.Vec.len sd.path
  let (b1, size) ←
    if n > 0#usize
    then
      do
      let f ← float.F32.sub b.max_x b.min_x
      let f1 ← float.F32.sub b.max_y b.min_y
      ok (b, ({ x := f, y := f1 } : sim.basic.Vec2))
    else do
         let size1 ← sim.basic.VEC2_ZERO
         ok (b, size1)
  let tl ←
    if n > 0#usize
    then ok ({ x := b1.min_x, y := b1.min_y } : sim.basic.Vec2)
    else sim.basic.VEC2_ZERO
  if n = 0#usize
  then ok (core.result.Result.Err sim.err.SimErr.EmptyPath)
  else
    let v0 ←
      alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice
        sim.basic.Vec2) sd.path 0#usize
    let v ← sim.basic.Vec2.sub v0 tl
    ok (core.result.Result.Ok (size, v))

