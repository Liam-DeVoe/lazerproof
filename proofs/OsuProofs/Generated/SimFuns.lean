    then
      let cur ← float.F32.sub f1 os.accumulated_at_last_completion
      let f2 ← float.F32.abs cur
      let f3 ← sim.netx.f32_max os.current_spin_max f2
      let (r, f4, f5, i, f6) ←
        sim.step.report_delta_loop f1 os.accumulated_at_last_completion f3
          os.completed_spins os.last_report_time t 1000000#u32
      ok (r,
        {
          os
            with
            total_accumulated := f1,
            accumulated_at_last_completion := f4,
            current_spin_max := f5,
            completed_spins := i,
            last_report_time := f6
        })
    else
      let f2 ← float.F32.sub f1 os.accumulated_at_last_completion
      let f3 ← float.F32.abs f2
      ok (core.result.Result.Ok (),
        {
          os
            with
            total_accumulated := f1,
            current_spin_max := f3,
            last_report_time := t
        })

