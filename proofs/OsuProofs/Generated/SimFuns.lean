    Source: 'osu_eval_core/src/sim/step.rs', lines 339:0-353:1
    Visibility: public -/
def sim.step.health_apply
  (h0 : sim.scoring.HealthSt) (hc : sim.scoring.HealthCfg)
  (c : sim.mods.Config) (j : sim.scoring.JInfo) (t : float.F64)
  (replay_player : Bool) (last_frame_time : Option float.F64) :
  Result (sim.scoring.HealthSt × Bool)
  := do
  if h0.has_failed
  then
    let hs ← sim.scoring.HealthSt.Insts.CoreCloneClone.clone h0
    ok (hs, true)
  else
    let (cr, inc) ← sim.scoring.increase_for h0 hc j false
    let h ← sim.scoring.HealthSt.Insts.CoreCloneClone.clone h0
    let f ← float.F64.add h.health inc
