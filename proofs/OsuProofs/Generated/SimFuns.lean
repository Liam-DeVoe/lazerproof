/-- [osu_eval_core::sim::basic::rot_l]:
    Source: 'osu_eval_core/src/sim/basic.rs', lines 364:0-376:1
    Visibility: public -/
def sim.basic.rot_l
  (m : sim.basic.Mat3) (rad : float.F32) : Result sim.basic.Mat3 := do
  let c ← float.F32.cos rad
  let s ← float.F32.sin rad
  let f ← float.F32.mul m.m11 c
  let f1 ← float.F32.mul m.m21 s
  let f2 ← float.F32.add f f1
  let f3 ← float.F32.mul m.m12 c
  let f4 ← float.F32.mul m.m22 s
  let f5 ← float.F32.add f3 f4
  let f6 ← float.F32.mul m.m13 c
  let f7 ← float.F32.mul m.m23 s
  let f8 ← float.F32.add f6 f7
  let f9 ← float.F32.mul m.m21 c
  let f10 ← float.F32.mul m.m11 s
  let f11 ← float.F32.sub f9 f10
  let f12 ← float.F32.mul m.m22 c
  let f13 ← float.F32.mul m.m12 s
  let f14 ← float.F32.sub f12 f13
  let f15 ← float.F32.mul m.m23 c
  let f16 ← float.F32.mul m.m13 s
  let f17 ← float.F32.sub f15 f16
  ok
    {
      m
        with
        m11 := f2, m12 := f5, m13 := f8, m21 := f11, m22 := f14, m23 := f17
    }

/-- [osu_eval_core::sim::basic::rot_r]:
    Source: 'osu_eval_core/src/sim/basic.rs', lines 379:0-391:1
    Visibility: public -/
def sim.basic.rot_r
  (m : sim.basic.Mat3) (rad : float.F32) : Result sim.basic.Mat3 := do
  let c ← float.F32.cos rad
  let s ← float.F32.sin rad
  let f ← float.F32.mul m.m11 c
  let f1 ← float.F32.mul m.m12 s
  let f2 ← float.F32.sub f f1
  let f3 ← float.F32.mul m.m12 c
  let f4 ← float.F32.mul m.m11 s
  let f5 ← float.F32.add f3 f4
  let f6 ← float.F32.mul m.m21 c
  let f7 ← float.F32.mul m.m22 s
  let f8 ← float.F32.sub f6 f7
  let f9 ← float.F32.mul m.m22 c
  let f10 ← float.F32.mul m.m21 s
  let f11 ← float.F32.add f9 f10
  let f12 ← float.F32.mul m.m31 c
  let f13 ← float.F32.mul m.m32 s
  let f14 ← float.F32.sub f12 f13
  let f15 ← float.F32.mul m.m32 c
  let f16 ← float.F32.mul m.m31 s
  let f17 ← float.F32.add f15 f16
  ok
