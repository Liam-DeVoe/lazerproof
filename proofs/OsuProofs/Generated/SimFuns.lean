/-- [osu_eval_core::sim::geometry::is_mouse_in_follow_area]:
    Source: 'osu_eval_core/src/sim/geometry.rs', lines 377:0-390:1
    Visibility: public -/
def sim.geometry.is_mouse_in_follow_area
  (h : sim.playable.HObj) (sd : sim.playable.SliderData)
  (g : sim.geometry.SliderGeom) (mouse : Option sim.basic.Vec2) (t : float.F64)
  (expanded : Bool) :
  Result (core.result.Result Bool sim.err.SimErr)
  := do
  match mouse with
  | none => ok (core.result.Result.Ok false)
  | some pos =>
    let radius ← sim.geometry.follow_radius h expanded
    let f ← float.F64.sub t h.start
    let fp0 ← float.F64.div f sd.duration
    let f1 ← sim.geometry.F64_0
    let b ← float.F64.lt fp0 f1
    let follow_progress ←
      if b
      then ok f1
      else
        do
        let f2 ← sim.geometry.F64_1
        let b1 ← float.F64.lt f2 fp0
        if b1
        then ok f2
        else ok fp0
    let r ← sim.geometry.curve_position_at sd follow_progress
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let m ← sim.geometry.mouse_in_slider g pos
      let v ← sim.basic.Vec2.sub m val
      let f2 ← sim.basic.Vec2.length_squared v
      let f3 ← float.F32.mul radius radius
      let b1 ← float.F32.le f2 f3
      ok (core.result.Result.Ok b1)
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Bool (core.convert.FromSame sim.err.SimErr) residual

