def sim.basic.fix_scale (s : float.F32) : Result float.F32 := do
  let f ← float.F32.abs s
  let f1 ← sim.basic.FLOAT_EPSILON
  let b ← float.F32.lt f f1
  if b
  then
    let f2 ← sim.basic.F32_0
    let b1 ← float.F32.eq s f2
    if b1
    then ok f1
    else let b2 ← float.F32.lt s f2
         if b2
         then float.F32.neg f1
         else ok f1
  else ok s

/-- [osu_eval_core::sim::basic::apply_transform]:
    Source: 'osu_eval_core/src/sim/basic.rs', lines 171:0-188:1
    Visibility: public -/
def sim.basic.apply_transform
  (di : sim.basic.DrawInfo) (translation : sim.basic.Vec2)
  (scale : sim.basic.Vec2) (origin : sim.basic.Vec2) :
  Result sim.basic.DrawInfo
  := do
  let v ← sim.basic.VEC2_ZERO
  let b ← sim.basic.Vec2.eq translation v
  let (m, mi) ←
    if b
    then ok (di.matrix, di.inverse)
    else
      do
      let m1 ← sim.basic.translate_from_left di.matrix translation
      let v1 ← sim.basic.Vec2.neg translation
      let mi1 ← sim.basic.translate_from_right di.inverse v1
      ok (m1, mi1)
  let v1 ← sim.basic.VEC2_ONE
  let b1 ← sim.basic.Vec2.eq scale v1
  let (m1, mi1) ←
    if b1
    then ok (m, mi)
    else
      do
      let f ← sim.basic.fix_scale scale.x
      let f1 ← sim.basic.fix_scale scale.y
      let m2 ← sim.basic.scale_from_left m { x := f, y := f1 }
      let f2 ← sim.basic.F32_1
      let f3 ← float.F32.div f2 f
      let f4 ← float.F32.div f2 f1
      let mi2 ← sim.basic.scale_from_right mi { x := f3, y := f4 }
      ok (m2, mi2)
  let b2 ← sim.basic.Vec2.eq origin v
  if b2
  then ok { matrix := m1, inverse := mi1 }
  else
    let v2 ← sim.basic.Vec2.neg origin
    let m2 ← sim.basic.translate_from_left m1 v2
    let mi2 ← sim.basic.translate_from_right mi1 origin
    ok { matrix := m2, inverse := mi2 }

