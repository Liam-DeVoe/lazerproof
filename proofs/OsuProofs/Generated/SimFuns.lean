    let b ← float.F32.lt f7 delta
    let delta1 ←
      if b
      then do
           let f8 ← sim.step.F32_360
           float.F32.sub delta f8
      else ok delta
    let f8 ← float.F32.neg f7
    let b1 ← float.F32.lt delta1 f8
    let delta2 ←
      if b1
      then do
           let f9 ← sim.step.F32_360
           float.F32.add delta1 f9
      else ok delta1
    if os.spin_tracking
    then
      if spinnable
      then
        let f9 ← float.F32.to_f64 delta2
        let f10 ← float.F64.abs rate
        let f11 ← float.F64.mul f9 f10
        let d ← float.F64.to_f32 f11
        let (r, os1) ←
          sim.step.report_delta { os with last_angle := o } s.t d
        let cf ← core.result.Result.Insts.CoreOpsTry.branch r
        match cf with
        | core.ops.control_flow.ControlFlow.Continue _ =>
          let v := index_mut_back { os1 with last_angle := (some this_angle) }
          ok (core.result.Result.Ok (), { s with objs := v })
        | core.ops.control_flow.ControlFlow.Break residual =>
          let r1 ←
            core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
              Unit (core.convert.FromSame sim.err.SimErr) residual
          let v := index_mut_back os1
          ok (r1, { s with objs := v })
      else
        let v := index_mut_back { os with last_angle := (some this_angle) }
        ok (core.result.Result.Ok (), { s with objs := v })
    else
      let v := index_mut_back { os with last_angle := (some this_angle) }
      ok (core.result.Result.Ok (), { s with objs := v })

