  | none =>
    let v := index_mut_back os
    ok (core.result.Result.Ok (), { s with objs := v })
  | some pos =>
    let f ← sim.basic.F32_2
    let f1 ← float.F32.div g.tracker_size.x f
    let f2 ← float.F32.sub pos.x f1
    let f3 ← float.F32.div g.tracker_size.y f
