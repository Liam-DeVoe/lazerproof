  let ss1 ← sim.step.completed s.score_rp c1.smax.max_hits s.t
  let (r, hs) ← sim.scoring.drain s.health c1.hcfg s.t elapsed
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue _ =>
    let (r1, hs1) ← sim.scoring.drain s.health_rp c1.hcfg s.t elapsed
    ok (r1,
      {
        s
          with
          score := ss,
          health := hs,
          score_rp := ss1,
          health_rp := hs1,
          clock_rate := f2
      })
  | core.ops.control_flow.ControlFlow.Break residual =>
    let r1 ←
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        Unit (core.convert.FromSame sim.err.SimErr) residual
    ok (r1,
      { s with score := ss, health := hs, score_rp := ss1, clock_rate := f2 })

