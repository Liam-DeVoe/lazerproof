      | core.ops.control_flow.ControlFlow.Continue val1 =>
        let f1 ← float.F64.sub val1 val
        let f2 ← float.F64.mul c.drain_rate f1
        let f3 ← float.F64.sub h.health f2
        let f4 ← sim.scoring.clamp01 f3
        ok (core.result.Result.Ok (),
          { h with health := f4, nearest_index := idx })
      | core.ops.control_flow.ControlFlow.Break residual =>
        let r2 ←
          core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
            Unit (core.convert.FromSame sim.err.SimErr) residual
        ok (r2, { h with nearest_index := idx })
    | core.ops.control_flow.ControlFlow.Break residual =>
      let r1 ←
        core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
          Unit (core.convert.FromSame sim.err.SimErr) residual
      ok (r1, { h with nearest_index := idx })

