def sim.geometry.spinner_geom_p
  (hoc : sim.basic.DrawInfo) (hoc_size : sim.basic.Vec2)
  (pl : sim.geometry.Placement) :
  Result sim.geometry.SpinnerGeom
  := do
  let f ← sim.basic.F32_1
  let f1 ← float.F32.div hoc_size.x f
  let f2 ← float.F32.div hoc_size.y f
  let f3 ← float.F32.mul f f1
  let f4 ← float.F32.mul f f2
  let v ← sim.geometry.centre_of { x := f3, y := f4 }
  let v1 ← sim.basic.VEC2_ZERO
  let sp ← sim.geometry.child_draw_info_r hoc pl.pos v1 pl.scale pl.rot v
  let _ ← float.F32.div f3 f
  let f5 ← float.F32.div f4 f
  let a_h ← float.F32.mul f f5
  let v2 ← sim.geometry.VEC2_HALF
  let v3 ← sim.basic.Vec2.mul v2 { x := f3, y := f4 }
  let v4 ← sim.geometry.centre_of { x := a_h, y := a_h }
  let v5 ← sim.basic.VEC2_ONE
  let aspect ← sim.geometry.child_draw_info sp v1 v3 v5 v4
  let f6 ← float.F32.div a_h f
  let f7 ← float.F32.div a_h f
  let f8 ← float.F32.mul f f6
  let f9 ← float.F32.mul f f7
  ok { aspect, tracker_size := { x := f8, y := f9 } }

