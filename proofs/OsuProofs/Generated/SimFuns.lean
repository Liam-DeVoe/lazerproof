def sim.step.present_tf
  (tf : sim.transforms.TObj) (armed : sim.state.Armed) (now : float.F64)
  (lifetime_start : float.F64) :
  Result Bool
  := do
  let f ← sim.step.ALPHA_PRESENT
  let b ← float.F32.lt f tf.alpha
  if b
  then
    let f1 ← sim.basic.F32_0
    let b1 ← float.F32.eq tf.scale.x f1
    if b1
    then
      let b2 ←
        sim.state.Armed.Insts.CoreCmpPartialEqArmed.eq armed
          sim.state.Armed.Idle
      if b2
      then float.F64.le lifetime_start now
      else ok false
    else
      let b2 ← float.F32.eq tf.scale.y f1
      if b2
      then
        let b3 ←
          sim.state.Armed.Insts.CoreCmpPartialEqArmed.eq armed
            sim.state.Armed.Idle
        if b3
        then float.F64.le lifetime_start now
        else ok false
      else ok true
  else
    let b1 ←
      sim.state.Armed.Insts.CoreCmpPartialEqArmed.eq armed sim.state.Armed.Idle
    if b1
    then float.F64.le lifetime_start now
    else ok false

