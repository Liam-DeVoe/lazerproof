    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice sim.state.Inst)
      s.insts k
  let f3 ← float.F32.cos s.theta
  let f4 ← float.F32.sin s.theta
  let off ← sim.basic.Vec2.scale { x := f3, y := f4 } appear_distance
  let f5 ← float.F64.sub h.start h.preempt
  let f6 ← sim.step.F64_1
  let appear_time ← float.F64.sub f5 f6
  let move_duration ← float.F64.add h.preempt f6
  let (saved, s1) ← sim.step.with_abs_begin s k now appear_time
  let (i1, index_mut_back) ←
    alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice
      sim.state.Inst) s1.insts k
  let v ← sim.basic.VEC2_ZERO
  let f7 ← sim.step.F64_0
  let (sq, t) ←
    sim.transforms.transform_to i1.tf now sim.transforms.Member.Position v f7
      net.framework.Easing.None (some off)
  let v1 := index_mut_back { i1 with tf := t }
  let (i2, index_mut_back1) ←
    alloc.vec.Vec.index_mut (core.slice.index.SliceIndexUsizeSlice
      sim.state.Inst) v1 k
  let (_, t1) ←
    sim.transforms.seq_append sq i2.tf now sim.transforms.Member.Position
      i.tf.pos move_duration net.framework.Easing.InOutSine none
  let v2 := index_mut_back1 { i2 with tf := t1 }
  let s2 ← sim.step.with_abs_end { s1 with insts := v2 } k saved
  let f8 ← float.F64.to_f32 h.fade_in
  let f9 ← sim.step.F32_1000
  let f10 ← float.F32.div f8 f9
  let f11 ← float.F32.add s2.theta f10
  ok { s2 with theta := f11 }

