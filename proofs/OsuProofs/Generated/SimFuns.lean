  let accuracy_progress ←
    if m.maximum_accuracy_judgement_count > 0#u64
    then
      do
      let f3 ← float.F64.from_u64 s.current_accuracy_judgement_count
      let f4 ← float.F64.from_u64 m.maximum_accuracy_judgement_count
      float.F64.div f3 f4
