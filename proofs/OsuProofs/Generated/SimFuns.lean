def sim.autogen.calc_spinner_start
  (prev_pos : net.osutk.Vector2) :
  Result (net.osutk.Vector2 × float.F32)
  := do
  let centre ← sim.autogen.spinner_centre
  let off ← net.osutk.v2_sub centre prev_pos
  let dist_from_centre ← net.osutk.v2_length off
  let f ← float.F32.mul dist_from_centre dist_from_centre
  let f1 ← sim.autogen.SPIN_RADIUS
  let f2 ← float.F32.mul f1 f1
  let f3 ← float.F32.sub f f2
  let dist_to_tangent_point ← float.F32.sqrt f3
  let b ← float.F32.lt f1 dist_from_centre
  if b
  then
    let f4 ← float.F32.div f1 dist_from_centre
    let angle ← float.F32.asin f4
    let f5 ← sim.autogen.F32_0
    let b1 ← float.F32.lt f5 angle
    let dir ←
      if b1
      then do
           let f6 ← sim.autogen.F32_1
           float.F32.neg f6
      else sim.autogen.F32_1
    let f6 ← float.F32.cos angle
    let f7 ← float.F32.mul off.x f6
    let f8 ← float.F32.sin angle
    let f9 ← float.F32.mul off.y f8
    let x ← float.F32.sub f7 f9
    let f10 ← float.F32.mul x f8
    let f11 ← float.F32.mul off.y f6
    let y ← float.F32.add f10 f11
    let v ← net.osutk.v2 x y
    let o ← net.osutk.v2_normalized v
    let o2 ← net.osutk.v2_scale o dist_to_tangent_point
    let v1 ← net.osutk.v2_add prev_pos o2
    ok (v1, dir)
  else
    let f4 ← sim.autogen.F32_0
    let b1 ← float.F32.lt f4 dist_from_centre
    if b1
    then
      let f5 ← float.F32.div f1 dist_from_centre
      let v ← net.osutk.v2_scale off f5
