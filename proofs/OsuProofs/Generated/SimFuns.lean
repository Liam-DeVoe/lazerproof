def sim.step.simulate
  (env : sim.geometry.Env) (cfg : sim.mods.Config) (pb : sim.playable.Playable)
  (frames : alloc.vec.Vec replay.frames.Frame)
  (kind : sim.schedule.ScheduleKind) :
  Result (core.result.Result (sim.state.Ctx × sim.state.St) sim.err.SimErr)
  := do
  let r ← sim.step.mk_ctx env cfg pb frames kind
  let cf ← core.result.Result.Insts.CoreOpsTry.branch r
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let r1 ← sim.step.run_with val
    let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
    match cf1 with
    | core.ops.control_flow.ControlFlow.Continue val1 =>
      ok (core.result.Result.Ok (val, val1))
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
        (sim.state.Ctx × sim.state.St) (core.convert.FromSame sim.err.SimErr)
        residual
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
      (sim.state.Ctx × sim.state.St) (core.convert.FromSame sim.err.SimErr)
      residual

