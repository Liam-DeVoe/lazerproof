                with
                hit_action := o1,
                tracking := false,
                accept_any_after := o2,
                last_pressed := s.pressed
            }
        ok { s with objs := v }
    else
      let v :=
        index_mut_back
          {
            os
              with
              hit_action := o1,
              tracking := false,
              accept_any_after := o2,
              last_pressed := s.pressed
          }
      ok { s with objs := v }
  else
    if valid_pos
