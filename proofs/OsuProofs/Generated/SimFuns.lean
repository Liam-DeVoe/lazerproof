def sim.step.wiggle_one
  (rng : net.random.State) (strength : float.F64) (origin : sim.basic.Vec2) :
  Result (sim.basic.Vec2 × net.random.State)
  := do
  let (a, rng1) ← net.random.sample rng
  let (b, rng2) ← net.random.sample rng1
  let f ← float.F64.from_bits 4611686018427387904#u64
  let f1 ← float.F64.mul a f
  let f2 ← net.framework.PI
  let f3 ← float.F64.mul f1 f2
  let ang ← float.F64.to_f32 f3
  let f4 ← float.F64.mul b strength
  let f5 ← float.F64.from_bits 4619567317775286272#u64
  let f6 ← float.F64.mul f4 f5
  let dist ← float.F64.to_f32 f6
  let f7 ← float.F32.to_f64 dist
  let f8 ← float.F32.to_f64 ang
  let f9 ← float.F64.cos f8
  let f10 ← float.F64.mul f7 f9
  let f11 ← float.F32.to_f64 origin.x
  let f12 ← float.F64.add f10 f11
  let f13 ← float.F64.to_f32 f12
  let f14 ← float.F64.sin f8
  let f15 ← float.F64.mul f7 f14
  let f16 ← float.F32.to_f64 origin.y
  let f17 ← float.F64.add f15 f16
  let f18 ← float.F64.to_f32 f17
  ok ({ x := f13, y := f18 }, rng2)

