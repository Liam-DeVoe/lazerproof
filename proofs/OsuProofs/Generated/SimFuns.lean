def sim.step.trigger_failure
  (c : sim.mods.Config) (h0 : sim.scoring.HealthSt) (t : float.F64)
  (replay_player : Bool) (last_frame_time : Option float.F64) :
  Result sim.scoring.HealthSt
  := do
  if h0.has_failed
  then sim.scoring.HealthSt.Insts.CoreCloneClone.clone h0
  else
    let h ← sim.scoring.HealthSt.Insts.CoreCloneClone.clone h0
    let i ← h.fail_triggers + 1#u64
    if replay_player
    then
      match last_frame_time with
      | none => ok { h with fail_triggers := i }
      | some lf =>
        let b ← float.F64.le lf t
        if b
        then
          let (f, v, stop) ←
            sim.step.trigger_failure_loop0 c h.health h.retries false 0#usize
          if stop
          then ok { h with health := f, fail_triggers := i, retries := v }
          else
            ok
              {
                h
                  with
                  health := f,
                  has_failed := true,
                  fail_triggers := i,
                  failed := true,
                  fail_time := (some t),
                  retries := v
              }
        else ok { h with fail_triggers := i }
    else
      let (f, v, stop) ←
        sim.step.trigger_failure_loop1 c h.health h.retries false 0#usize
      if stop
      then ok { h with health := f, fail_triggers := i, retries := v }
      else
        ok
          {
            h
              with
              health := f,
              has_failed := true,
              fail_triggers := i,
              failed := true,
              fail_time := (some t),
              retries := v
          }

/-- [osu_eval_core::sim::step::fail_condition]:
    Source: 'osu_eval_core/src/sim/step.rs', lines 310:0-323:1
    Visibility: public -/
def sim.step.fail_condition
  (j : sim.scoring.JInfo) (fc : sim.mods.FailCond) : Result Bool := do
  match fc with
  | sim.mods.FailCond.SuddenDeath tail =>
    let b ← sim.basic.affects_combo j.ty
    if b
    then
      let b1 ← sim.basic.is_hit j.ty
      if b1
      then
        if tail
        then
          let b2 ←
            sim.playable.Kind.Insts.CoreCmpPartialEqKind.eq j.kind
              sim.playable.Kind.Tail
          if b2
          then ok (¬ b1)
          else ok false
        else ok false
      else ok true
    else
      if tail
      then
        let b1 ←
          sim.playable.Kind.Insts.CoreCmpPartialEqKind.eq j.kind
            sim.playable.Kind.Tail
        if b1
        then let b2 ← sim.basic.is_hit j.ty
             ok (¬ b2)
        else ok false
      else ok false
  | sim.mods.FailCond.Perfect =>
    let b ← sim.basic.affects_accuracy j.min_result
    let rel_min ← if b
                    then ok true
                    else sim.basic.affects_combo j.min_result
    let b1 ← sim.basic.affects_accuracy j.max_result
    let rel_max ←
      if b1
      then ok true
      else sim.basic.affects_combo j.max_result
    let b2 ← sim.basic.affects_accuracy j.ty
    let rel_ty ← if b2
                   then ok true
                   else sim.basic.affects_combo j.ty
    if rel_min
    then
      core.cmp.PartialEq.ne.trait_default
        sim.basic.HitResult.Insts.CoreCmpPartialEqHitResult j.ty j.max_result
    else
      if rel_max
      then
        core.cmp.PartialEq.ne.trait_default
          sim.basic.HitResult.Insts.CoreCmpPartialEqHitResult j.ty j.max_result
      else
        if rel_ty
        then
          core.cmp.PartialEq.ne.trait_default
            sim.basic.HitResult.Insts.CoreCmpPartialEqHitResult j.ty
            j.max_result
        else ok false
  | sim.mods.FailCond.TargetPractice =>
    let b ← sim.basic.affects_combo j.ty
    if b
    then let b1 ← sim.basic.is_hit j.ty
         ok (¬ b1)
    else ok false

