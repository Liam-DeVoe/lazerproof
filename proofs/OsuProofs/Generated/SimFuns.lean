    let b ←
      sim.scoring.default_fail_condition
        { h with health := f1, combo_result := cr } j
    if b
    then
      let hs ←
        sim.step.trigger_failure c { h with health := f1, combo_result := cr }
          t replay_player last_frame_time
      ok (hs, false)
    else
      let b1 ← sim.step.any_fail_condition c j
      if b1
      then
        let hs ←
          sim.step.trigger_failure c
            { h with health := f1, combo_result := cr } t replay_player
            last_frame_time
        ok (hs, false)
      else ok ({ h with health := f1, combo_result := cr }, false)

