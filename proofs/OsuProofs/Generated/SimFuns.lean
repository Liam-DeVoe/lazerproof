/-- [osu_eval_core::sim::basic::apply_transform_r]:
    Source: 'osu_eval_core/src/sim/basic.rs', lines 394:0-418:1
    Visibility: public -/
def sim.basic.apply_transform_r
  (di : sim.basic.DrawInfo) (translation : sim.basic.Vec2)
  (scale : sim.basic.Vec2) (rotation : float.F32) (origin : sim.basic.Vec2) :
  Result sim.basic.DrawInfo
  := do
  let f ← sim.basic.F32_0
  let b ← float.F32.eq rotation f
  if b
  then sim.basic.apply_transform di translation scale origin
  else
    let v ← sim.basic.VEC2_ZERO
    let b1 ← sim.basic.Vec2.eq translation v
    let (m, mi) ←
      if b1
      then ok (di.matrix, di.inverse)
      else
        do
        let m1 ← sim.basic.translate_from_left di.matrix translation
        let v1 ← sim.basic.Vec2.neg translation
        let mi1 ← sim.basic.translate_from_right di.inverse v1
        ok (m1, mi1)
    let rad ← net.sysmisc.f32_degrees_to_radians rotation
    let m1 ← sim.basic.rot_l m rad
    let f1 ← float.F32.neg rad
    let mi1 ← sim.basic.rot_r mi f1
    let v1 ← sim.basic.VEC2_ONE
    let b2 ← sim.basic.Vec2.eq scale v1
    let (m2, mi2) ←
      if b2
      then ok (m1, mi1)
      else
        do
        let f2 ← sim.basic.fix_scale scale.x
        let f3 ← sim.basic.fix_scale scale.y
        let m3 ← sim.basic.scale_from_left m1 { x := f2, y := f3 }
        let f4 ← sim.basic.F32_1
        let f5 ← float.F32.div f4 f2
        let f6 ← float.F32.div f4 f3
        let mi3 ← sim.basic.scale_from_right mi1 { x := f5, y := f6 }
        ok (m3, mi3)
    let b3 ← sim.basic.Vec2.eq origin v
    if b3
    then ok { matrix := m2, inverse := mi2 }
    else
      let v2 ← sim.basic.Vec2.neg origin
      let m3 ← sim.basic.translate_from_left m2 v2
      let mi3 ← sim.basic.translate_from_right mi2 origin
      ok { matrix := m3, inverse := mi3 }

