      let f4 ← float.F64.add s.current_base_score f3
      float.F64.div f4 m.maximum_base_score
    else sim.scoring.F64_1
  let maximum_accuracy ← sim.scoring.clamp01 f2
  let b2 ← float.F64.lt f m.maximum_combo_portion
  let combo_progress ←
    if b2
    then float.F64.div s.current_combo_portion m.maximum_combo_portion
